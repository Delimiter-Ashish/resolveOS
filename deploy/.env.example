# Copy to deploy/.env and fill in. Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
DB_PASSWORD=change-me
RESOLVEOS_SECRET_KEY=
RESOLVEOS_AGENT_API_KEY=
RESOLVEOS_APPROVER_API_KEY=
RESOLVEOS_OPERATOR_API_KEY=
RESOLVEOS_ADMIN_API_KEY=
RESOLVEOS_PUBLIC_URL=https://resolveos.example.com

# Hosted model (Gemini via its OpenAI-compatible endpoint) as the only provider:
RESOLVEOS_LLM_MODE=openai
RESOLVEOS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RESOLVEOS_LLM_API_KEY=your-gemini-key
RESOLVEOS_LLM_MODEL=gemini-flash-latest
RESOLVEOS_LLM_PRICE_IN=0.30
RESOLVEOS_LLM_PRICE_OUT=2.50
# ...or with the gpu profile: primary = local vLLM, strong = Gemini
# RESOLVEOS_LLM_BASE_URL=http://vllm:8000/v1
# RESOLVEOS_LLM_MODEL=resolveos-llm
# RESOLVEOS_STRONG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RESOLVEOS_STRONG_LLM_API_KEY=your-gemini-key
# RESOLVEOS_STRONG_LLM_MODEL=gemini-flash-latest

RESOLVEOS_CHAOS_ENABLED=0
RESOLVEOS_ALLOW_SIGNUP=1
# optional
# RESOLVEOS_SMTP_HOST=smtp.sendgrid.net
# RESOLVEOS_SMTP_USER=apikey
# RESOLVEOS_SMTP_PASSWORD=
# RESOLVEOS_SMTP_FROM=support@yourdomain.com
# RESOLVEOS_SLACK_SIGNING_SECRET=
# RESOLVEOS_METRICS_TOKEN=
