# Put this file at ResolveOS/.env (it is read automatically). Anything here can also be exported.
# scripts/env.sh already points RESOLVEOS_LLM_* at your local vLLM (primary model).

# ---- strong model for the router: Gemini via its OpenAI-compatible endpoint ----
RESOLVEOS_STRONG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RESOLVEOS_STRONG_LLM_API_KEY=PASTE_YOUR_GEMINI_KEY
# exact model id from Google AI Studio (e.g. the Flash model you have access to)
RESOLVEOS_STRONG_LLM_MODEL=gemini-flash-latest
# USD per 1M tokens: set to your model's real prices so cost dashboards are correct
RESOLVEOS_STRONG_PRICE_IN=0.30
RESOLVEOS_STRONG_PRICE_OUT=2.50
# auto = vLLM for routine steps, Gemini for flagged/complex/recovering steps; or: primary | strong
RESOLVEOS_ROUTER_MODE=auto

# ---- optional integrations ----
# RESOLVEOS_PUBLIC_URL=https://your-host        # used in one-tap approval links + chat widget
# RESOLVEOS_SMTP_HOST=smtp.gmail.com
# RESOLVEOS_SMTP_USER=you@gmail.com
# RESOLVEOS_SMTP_PASSWORD=app-password
# RESOLVEOS_SMTP_FROM=you@gmail.com
# RESOLVEOS_SLACK_SIGNING_SECRET=
# RESOLVEOS_METRICS_TOKEN=
